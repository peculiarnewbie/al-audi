{
    "name": "app",
    "private": true,
    "sideEffects": false,
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build && tsc --noEmit",
        "preview": "vite preview",
        "deploy": "npm run build && alchemy deploy --stage production --yes",
        "deploy:dev": "npm run build && alchemy deploy --yes",
        "cf-typegen": "wrangler types",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:workers": "vitest run --config vitest.workers.config.ts",
        "test:e2e": "vitest run --config vitest.e2e.config.ts",
        "test:all": "vitest run && vitest run --config vitest.workers.config.ts && vitest run --config vitest.e2e.config.ts"
    },
    "dependencies": {
        "@solid-primitives/i18n": "^2.2.1",
        "@tanstack/solid-router": "^1.170.10",
        "@tanstack/solid-router-devtools": "^1.167.0",
        "@tanstack/solid-start": "^1.168.18",
        "@types/qrcode": "^1.5.6",
        "alchemy": "2.0.0-beta.48",
        "animejs": "^4.4.1",
        "better-auth": "^1.6.13",
        "drizzle-orm": "1.0.0-rc.3",
        "effect": "4.0.0-beta.74",
        "luxon": "^3.7.2",
        "nanoid": "^5.1.11",
        "qrcode": "^1.5.4",
        "solid-js": "^1.9.13"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.39.0",
        "@cloudflare/vitest-pool-workers": "^0.16.10",
        "@tailwindcss/vite": "^4.3.0",
        "@types/luxon": "^3.7.1",
        "@types/node": "^25.9.1",
        "drizzle-kit": "1.0.0-rc.4-ca0f029",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.14",
        "vite-plugin-solid": "^2.11.12",
        "vitest": "^4.1.8",
        "wrangler": "^4.95.0"
    }
}
